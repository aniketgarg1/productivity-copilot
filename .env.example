# =============================================================
# Copy this file to `.env` and fill in the values marked YOU.
#   cp .env.example .env
# =============================================================

# ---- Core -----------------------------------------------------
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
DATABASE_URL=postgresql://postgres:postgres@db:5432/copilot

# YOU: any random string. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=change-this-to-any-random-string

# true for local http dev; set false when serving over HTTPS
DEV_MODE=true

# ---- Google OAuth / Calendar (required) -----------------------
# YOU: from Google Cloud Console → APIs & Services → Credentials
#      → Create OAuth client ID → Web application
#      Authorized redirect URI: http://localhost:8000/auth/google/callback
GOOGLE_CLIENT_ID=YOUR_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_CLIENT_SECRET

# Local dev OAuth helpers (Google returns broader scopes than requested):
OAUTHLIB_RELAX_TOKEN_SCOPE=1
OAUTHLIB_INSECURE_TRANSPORT=1

# ---- Scheduling behaviour -------------------------------------
# IANA timezone name, e.g. Asia/Kolkata, America/New_York
TIMEZONE=America/Phoenix
WORKDAY_START_HOUR=9
WORKDAY_END_HOUR=18
SLOT_PADDING_MINUTES=5

# ---- LLM (required) -------------------------------------------
LLM_PROVIDER=openai
# YOU: https://platform.openai.com/api-keys
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
# Cost-effective defaults (pinned snapshot)
OPENAI_MODEL_MAIN=gpt-4.1-mini-2025-04-14
OPENAI_MODEL_CHEAP=gpt-4.1-nano-2025-04-14
OPENAI_TRANSCRIBE_MODEL=whisper-1

# ---- Twilio (optional — daily AI check-in calls) --------------
# YOU: https://console.twilio.com → Account SID / Auth Token,
#      and a voice-capable number you own (E.164 format).
TWILIO_ACCOUNT_SID=YOUR_TWILIO_SID
TWILIO_AUTH_TOKEN=YOUR_TWILIO_AUTH_TOKEN
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX
# Verifies webhooks really came from Twilio. Only set false while testing
# the /calls/* webhooks by hand.
TWILIO_VALIDATE_SIGNATURE=true

# ---- Daily check-in settings ----------------------------------
DAILY_CHECKIN_ENABLED=true
DAILY_CHECKIN_HOUR=9
